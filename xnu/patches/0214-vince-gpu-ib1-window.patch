+/* Same, but starting at a dword offset: used for the CP's stop position. */
+static void
+dump_ib_window(uint64_t pa, uint32_t dwords, uint32_t at, const char *what)
+{
+	uint32_t start = at > 8 ? at - 8 : 0;
+	uint32_t n = MIN(dwords - start, 24u);
+	vm_size_t bytes = (vm_size_t)((pa & 0xfffu) + (uint64_t)(start + n) * 4u);
+	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), (bytes + 0xfffu) & ~(vm_size_t)0xfffu);
+
+	if (va == 0) {
+		return;
+	}
+	printf("adreno:  ib1 %s at %u/%u:", what, at, dwords);
+	for (uint32_t j = 0; j < n; j++) {
+		printf(" %#x", reg_read(va, (uint32_t)(pa & 0xfffu) + (start + j) * 4u));
+	}
+	printf("\n");
+}
+
+/* An IB can contain indirect buffers; dump one level of those too. */
+static void
+dump_nested_ibs(uint64_t pa, uint32_t dwords)
+{
+	uint32_t n = MIN(dwords, 512u);
+	vm_size_t bytes = (vm_size_t)((pa & 0xfffu) + (uint64_t)n * 4u);
+	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), (bytes + 0xfffu) & ~(vm_size_t)0xfffu);
+	uint32_t off = (uint32_t)(pa & 0xfffu);
+	uint32_t j = 0;
+
+	if (va == 0) {
+		return;
+	}
+	while (j < n) {
+		uint32_t h = reg_read(va, off + j * 4u);
+
+		if ((h & 0x70000000u) == 0x70000000u) {
+			uint32_t cnt = h & 0x3fffu;
+			uint32_t op = (h >> 16) & 0x7fu;
+
+			if (op == CP_INDIRECT_BUFFER_PFE && cnt >= 3 && j + 4 <= n) {
+				uint64_t np = reg_read(va, off + (j + 1) * 4u) |
+				    ((uint64_t)reg_read(va, off + (j + 2) * 4u) << 32);
+				uint32_t nw = reg_read(va, off + (j + 3) * 4u);
+
+				if (nw >= 1 && nw <= 4096) {
+					printf("adreno:  nested ib at %u: pa %#llx dwords %u\n",
+					    j, (unsigned long long)np, nw);
+					dump_ib_words(np, nw);
+				}
+			}
+			j += cnt + 1;
+		} else if ((h & 0xc0000000u) == 0x40000000u) {
+			j += (h & 0x7fu) + 1;
+		} else {
+			j++;
+		}
+	}
+}
+
+/* A client IB while diagnosing submission; the error is usually deep in it. */
+static void
+dump_ib(uint64_t pa, uint32_t dwords)
+{
+	dump_ib_words(pa, dwords);
+	dump_nested_ibs(pa, dwords);
+}
