diff --git a/bsd/dev/vince_adreno.c b/bsd/dev/vince_adreno.c
index f5a90b8..e360d8a 100644
--- a/bsd/dev/vince_adreno.c
+++ b/bsd/dev/vince_adreno.c
@@ -32,8 +32,45 @@
 extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
 extern vm_offset_t kvtophys(vm_offset_t va);
 extern uint64_t sweet_pixels_alloc(vm_size_t size);   /* SweetSurface.cpp */
+extern unsigned long gPhysBase, gPhysSize;
+extern uint64_t phystokv_range(uint64_t pa, vm_size_t *max_len);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, unsigned length);
 void vince_adreno_init(void);
+void vince_gpu_flush(uint64_t pa, uint64_t size);
 extern void VinceGPUStart(void);
+
+/*
+ * CPU and GPU do not snoop each other: the client BOs are mapped cacheable,
+ * the SMMU stays in bypass, and VINCE.h's __ARM_COHERENT_IO__ compiles
+ * flush_dcache64() down to a bare DSB (Apple's fabric snoops; Adreno does
+ * not).  Walk the kernel's physical map and do the real maintenance, then
+ * invalidate so the next CPU read comes from DRAM as well.
+ */
+void
+vince_gpu_flush(uint64_t pa, uint64_t size)
+{
+	uint64_t end;
+
+	if (size == 0) {
+		return;
+	}
+	pa &= ~0xfffull;
+	end = (pa + size + 0xfffull) & ~0xfffull;
+	if (pa < (uint64_t)gPhysBase ||
+	    end > (uint64_t)gPhysBase + (uint64_t)gPhysSize) {
+		return;
+	}
+	while (pa < end) {
+		vm_size_t len = (vm_size_t)MIN((uint64_t)PAGE_SIZE, end - pa);
+		uint64_t va = phystokv_range(pa, &len);
+
+		if (va == 0 || len == 0) {
+			break;
+		}
+		FlushPoC_DcacheRegion((vm_offset_t)va, (unsigned)len);
+		pa += len;
+	}
+}
 
