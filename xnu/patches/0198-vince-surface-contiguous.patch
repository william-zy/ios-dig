+/*
+ * The GPU's SMMU is in bypass, so an imported surface must be one physically
+ * contiguous run.  Fall back to ordinary pages when that cannot be allocated
+ * (the CPU copy paths still work, only the GPU import fails).
+ */
+static IOBufferMemoryDescriptor *
+sweet_surface_alloc_pixels(uint32_t size, bool *contiguous)
+{
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous,
+	    size, page_size);
+	if (contiguous != NULL) {
+		*contiguous = mem != NULL;
+	}
+	if (mem == NULL) {
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, size, page_size);
+	}
+	return mem;
+}
