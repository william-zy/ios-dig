diff --git a/bsd/dev/vince_mmc.c b/bsd/dev/vince_mmc.c
--- a/bsd/dev/vince_mmc.c
+++ b/bsd/dev/vince_mmc.c
@@ -57,3 +57,5 @@
 #include <kern/locks.h>
 #include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
 #include <pexpert/pexpert.h>
@@ -39,6 +39,10 @@
 /* bsd/dev/vince_ctl.c: clean halt when the shim asks (tools/vince_halt.py) */
 extern void vince_ctl_start(void);
 extern void vince_smd_start(void);
+/* osfmk/console/serial_console.c: every console byte, 8 MiB ring */
+extern int hz;
+extern char vince_conlog[1 << 23];
+extern volatile uint64_t vince_conlog_pos;
 
 #define SDCC1_PHYS      0x07824000ul    /* MCI core; the SDHCI registers start at +0x900 */
 #define GCC_SDCC1_PHYS  0x01842000ul    /* SDCC1 BCR, then the apps RCG at +4 */
@@ -592,6 +592,116 @@
 	printf("VINCE MMC: no GPT partition named \"%s\"\n", want);
 	return ENOENT;
 }
 
+/*
+ * Persistent console log. serial_console.c keeps every console byte in the
+ * 8 MiB vince_conlog ring; this thread copies it, in order, to the last
+ * 4 MiB + one block of the partition, far past the HFS image. Block 0 of the
+ * area is a header:
+ *   "SWEETLOG" | u32 version | u32 size | u64 total | u64 sequence
+ * The data follows from block 1. Read it from recovery with
+ * tools/dig-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define DIG_LOG_AREA    (4u << 20)
+#define DIG_LOG_BLOCKS  (DIG_LOG_AREA / SECTOR)
+#define DIG_LOG_SECS    2
+#define DIG_LOG_RING    (1u << 23)
+
+struct dig_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static int vince_log_chan;
+
+static void
+vince_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = vm.nsect - DIG_LOG_BLOCKS - 1;
+	static char stage[MAX_SECTORS * SECTOR];
+	uint32_t stage_len = 0;
+	uint64_t pos = 0, disk = 0, seq = 0;
+
+	printf("VINCE LOG: console log at the last %u KiB of the partition (block 0x%llx)\n",
+	    (DIG_LOG_BLOCKS + 1) * SECTOR >> 10, base);
+	for (;;) {
+		uint64_t ring_total;
+		uint32_t sectors, tail, done = 0;
+		int error = 0;
+
+		(void)tsleep(&vince_log_chan, PZERO, "vincelog", hz * DIG_LOG_SECS);
+		ring_total = vince_conlog_pos;
+		while (stage_len < sizeof(stage) && pos < ring_total) {
+			uint32_t n = (uint32_t)MIN(ring_total - pos, (uint64_t)sizeof(stage) - stage_len);
+			for (uint32_t i = 0; i < n; i++) {
+				stage[stage_len + i] = vince_conlog[(pos + i) & (DIG_LOG_RING - 1)];
+			}
+			pos += n;
+			stage_len += n;
+		}
+		if (stage_len == 0) {
+			continue;
+		}
+		sectors = stage_len / SECTOR;
+		tail = stage_len - sectors * SECTOR;
+
+		lck_mtx_lock(&vince_mmc_lock);
+		while (done < sectors && !error) {
+			uint32_t n = MIN(sectors - done, MAX_SECTORS);
+			memcpy(vince_mmc_bounce, stage + (uint64_t)done * SECTOR, n * SECTOR);
+			error = mmc_write_sectors(base + 1 + (disk / SECTOR) + done, n);
+			done += n;
+		}
+		if (!error && tail) {
+			/* Show the partial sector now; the next round rewrites it. */
+			bzero(vince_mmc_bounce, SECTOR);
+			memcpy(vince_mmc_bounce, stage + sectors * SECTOR, tail);
+			error = mmc_write_sectors(base + 1 + (disk / SECTOR) + sectors, 1);
+		}
+		if (!error) {
+			struct dig_log_header h;
+			bzero(&h, sizeof(h));
+			memcpy(h.magic, "SWEETLOG", 8);
+			h.version = 1;
+			h.size = DIG_LOG_AREA;
+			h.total = pos;
+			h.seq = ++seq;
+			bzero(vince_mmc_bounce, SECTOR);
+			memcpy(vince_mmc_bounce, &h, sizeof(h));
+			error = mmc_write_sectors(base, 1);
+		}
+		lck_mtx_unlock(&vince_mmc_lock);
+		if (error) {
+			printf("VINCE LOG: write failed (%d), stopping\n", error);
+			break;
+		}
+		disk += (uint64_t)sectors * SECTOR;
+		if (tail) {
+			memmove(stage, stage + sectors * SECTOR, tail);
+		}
+		stage_len = tail;
+		if (disk >= DIG_LOG_AREA) {
+			printf("VINCE LOG: area full at %llu bytes\n", disk);
+			break;
+		}
+	}
+}
+
+static void
+vince_log_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !vm.rw || vm.nsect < 2 * (DIG_LOG_BLOCKS + 1)) {
+		return;
+	}
+	if (kernel_thread_start(vince_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* What the partition holds, for the log: the superblock magics at offset 1024 (HFS+, ext4, F2FS). */
 static const char *
@@ -896,9 +896,10 @@
 	    want, vm.first, vm.nsect * SECTOR >> 20, fs, vm.rw ? "read-write" : "read-only");
 	sweet_sample_start();
+	vince_log_start();
 	vince_input_start();
 	vince_ctl_start();
 	vince_smd_start();
 	return 0;
 }
 
