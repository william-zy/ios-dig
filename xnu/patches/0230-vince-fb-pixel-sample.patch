+						    (uint64_t)(sx + xx) * 4);
+						ns++;
+						if ((v & 0xffffffu) != 0) {
+							nz++;
+							if (first == 0) {
+								first = v;
+							}
+						}
+					}
+				}
+				IOLog("SWEET FB: layer %u surface %u sample %u/%u nonzero first %08x\n",
+				    layer, id, nz, ns, first);
+			}
 			for (int32_t y = 0; y < h; y++) {
 				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
 				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
@@ -567,6 +590,38 @@
 #if defined(ARM64_BOARD_CONFIG_VINCE)
 	if (fPanelBpp == 3) {
 		flushPanel();
+		if (fPanel != 0 && sweet_fb_pixel_logs < 16) {
+			uint32_t pz = 0, ps = 0, dpz = 0, dps = 0, first = 0;
+
+			sweet_fb_pixel_logs++;
+			for (uint32_t yy = 0; yy < fHeight; yy += 32) {
+				const uint32_t *row = (const uint32_t *)(fPixels +
