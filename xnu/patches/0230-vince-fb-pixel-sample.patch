+				volatile const uint8_t *prow = (volatile const uint8_t *)(fPanel +
+				    (uint64_t)yy * fPanelRowBytes);
+
+				for (uint32_t xx = 0; xx < fWidth; xx += 32) {
+					uint32_t v = row[xx];
+					uint32_t p = (uint32_t)prow[xx * 3] |
