 static uint32_t sweet_fb_swaps_logged;
 static bool sweet_fb_swepend_logged;
 static uint64_t sweet_fb_swap_count;
+static uint32_t sweet_fb_pixel_logs;
 
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
 /*
@@ -556,6 +557,28 @@
 			src = 0;
 		}
 		if (src != 0 && bpe == 4) {
+			/* Is the composited surface actually lit?  A black panel with a
+			 * black surface is a renderer problem, not a panel problem. */
+			if (sweet_fb_pixel_logs < 16) {
+				uint32_t nz = 0, ns = 0, first = 0;
+
+				for (int32_t yy = 0; yy < h; yy += 16) {
+					for (int32_t xx = 0; xx < w; xx += 16) {
+						uint32_t v = *(volatile uint32_t *)(src + s->offset +
