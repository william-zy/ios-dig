 void
-AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+AppleCLCD::startVsync(void)
+{
+	thread_t thread;
+
+	IOLockLock(fLock);
+	if (fVsyncThread == NULL &&
+		kernel_thread_start(AppleCLCD::vsyncThread, this, &thread) == KERN_SUCCESS) {
+		fVsyncThread = thread;
+		thread_deallocate(thread);
+		IOLog("SWEET FB: vsync thread started\n");
+	}
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::vsyncThread(void *arg, __unused wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+
+	for (;;) {
+		tsleep(&fb->fVsyncChan, PZERO, "sweetvsync", MAX(1, hz / 60));
+		fb->vsyncTick();
+	}
+}
