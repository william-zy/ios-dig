index f185f45..4f69c61 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -451,6 +451,7 @@ get32(const uint8_t *p, uint32_t off)
 }
 
 static uint32_t sweet_fb_swaps_logged;
+static bool sweet_fb_swepend_logged;
 static uint64_t sweet_fb_swap_count;
 
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
@@ -728,12 +729,29 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 		break;
 	case kSweetFBSwapEnd: {
 		uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
-		if (args->structureInputDescriptor != NULL ||
+		bool ool = args->structureInputDescriptor != NULL;
+
+		/* 0x46c is over the inline limit, so CA may hand it to us OOL. */
+		if (ool) {
+			if (args->structureInputDescriptor->getLength() < SWEET_FB_SWAP_REC_SIZE ||
+			    args->structureInputDescriptor->readBytes(0, rec, sizeof(rec)) != sizeof(rec)) {
+				ret = kIOReturnBadArgument;
+				break;
+			}
+		} else if (args->structureInput == NULL ||
 		    args->structureInputSize < SWEET_FB_SWAP_REC_SIZE) {
 			ret = kIOReturnBadArgument;
 			break;
+		} else {
+			memcpy(rec, args->structureInput, sizeof(rec));
+		}
+		if (!sweet_fb_swepend_logged) {
+			sweet_fb_swepend_logged = true;
+			IOLog("SWEET FB: SwapEnd via %s (%u bytes)\n",
+			    ool ? "OOL descriptor" : "inline input",
+			    (unsigned)(ool ? args->structureInputDescriptor->getLength()
+			        : args->structureInputSize));
 		}
-		memcpy(rec, args->structureInput, sizeof(rec));
 		fFB->swap(rec);
 		break;
 	}
