+uint32_t
+vince_gpu_surface_fence(uint32_t id)
+{
+	for (uint32_t i = 0; i < SURF_FENCE_SLOTS; i++) {
+		if (surf_fence[i].id == id) {
+			return surf_fence[i].fence;
+		}
+	}
+	return 0;
+}
+
+/*
+ * There is one CP ring, so waiting for the newest fence also covers every
+ * draw that touched a surface without being listed in its submit's BOs.
+ */
+bool
+vince_gpu_sync(uint32_t timeout_ms)
+{
+	uint32_t fence = gpu_fence;
+
+	for (uint32_t waited = 0; waited < timeout_ms; waited++) {
+		if (vince_gpu_done(fence)) {
+			return true;
+		}
+		delay(1000);
+	}
+	return vince_gpu_done(fence);
+}
+
 bool
