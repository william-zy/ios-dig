+/*
+ * Diagnostic reads/writes of client buffers.  Those pages are part of the
+ * kernel's physical map, so the direct map is enough.  ml_io_map is not an
+ * option: it allocates permanent entries from an 8 MiB io_submap, and
+ * ml_io_unmap tries to delete the parent permanent entry and panics.
+ */
+static bool
+dbg_ptr(uint64_t pa, volatile uint32_t **out)
+{
+	vm_size_t len = 4;
+
+	if (pa < (uint64_t)gPhysBase ||
+	    pa - (uint64_t)gPhysBase >= (uint64_t)gPhysSize) {
+		return false;
+	}
+	*out = (volatile uint32_t *)phystokv_range(pa, &len);
+	return *out != 0 && len != 0;
+}
+
+static uint32_t
+dbg_read32(uint64_t pa)
+{
+	volatile uint32_t *p;
+
+	return dbg_ptr(pa, &p) ? *p : 0xdeadbeefu;
+}
+
+static void
+dbg_write32(uint64_t pa, uint32_t val)
+{
+	volatile uint32_t *p;
+
+	if (dbg_ptr(pa, &p)) {
+		*p = val;
 	}
 }
 
