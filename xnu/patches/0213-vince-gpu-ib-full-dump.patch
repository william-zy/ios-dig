diff --git a/bsd/dev/vince_adreno.c b/bsd/dev/vince_adreno.c
index d0c3916..0a132f4 100644
--- a/bsd/dev/vince_adreno.c
+++ b/bsd/dev/vince_adreno.c
@@ -1010,10 +1010,16 @@ vince_gpu_done(uint32_t fence)
 void
 vince_gpu_status(void)
 {
+	static uint32_t status_calls;
 	uint32_t stat = gr(A5_RBBM_INT_0_STATUS);
 	uint32_t cpint = gr(A5_CP_INTERRUPT_STATUS);
 	uint32_t opcode = 0;
+	bool keep = stat != 0 || cpint != 0 || ++status_calls <= 8;
 
+	if (!keep && (status_calls % 60) != 0) {
+		gw(A5_RBBM_INT_CLEAR_CMD, stat & ~0x2u);
+		return;
+	}
 	if (cpint & 0x1u) {             /* CP_OPCODE_ERROR: PFP stat index 1 */
 		gw(A5_CP_PFP_STAT_ADDR, 0);
 		(void)gr(A5_CP_PFP_STAT_DATA);
@@ -1034,18 +1040,19 @@ vince_gpu_status(void)
 	gw(A5_RBBM_INT_CLEAR_CMD, stat & ~0x2u);
 }
 
-/* First dwords of a client IB; only used while diagnosing submission. */
+/* A client IB while diagnosing submission; the error is usually deep in it. */
 static void
 dump_ib(uint64_t pa, uint32_t dwords)
 {
-	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), 0x2000);
-	uint32_t n = MIN(dwords, 24u);
+	uint32_t n = MIN(dwords, 512u);
+	vm_size_t bytes = (vm_size_t)((pa & 0xfffu) + (uint64_t)n * 4u);
+	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), (bytes + 0xfffu) & ~(vm_size_t)0xfffu);
 
 	if (va == 0) {
 		printf("adreno:  ib dump failed\n");
 		return;
 	}
-	printf("adreno:  ib words:");
+	printf("adreno:  ib words (%u of %u):", n, dwords);
 	for (uint32_t j = 0; j < n; j++) {
 		printf(" %#x", reg_read(va, (uint32_t)(pa & 0xfffu) + j * 4u));
 	}
