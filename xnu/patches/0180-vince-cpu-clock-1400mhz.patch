  * put on CPUs 4-7 ran 40 times slower. Both clusters share VDD_APC, which already carries cluster 0 at 800 MHz:
  * give cluster 1 the same source. The A53 PLL (for more than 800 MHz) stays off; that needs CPR voltage control.
  */
+extern "C" boolean_t PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_arg);
+extern "C" void vince_smd_sleep(unsigned ms);
+
+/*
+ * APCS clocks and VDD_APC for DIG-AL00 (PM8937).  CPU0 is cluster 1 (MPIDR
+ * 0x100): its RCG is at 0x0b011050 and its A53 PLL at 0x0b016000; cluster 0
+ * (CPUs 4-7) uses 0x0b111050 and 0x0b116000.  The vendor SR2 PLL layout
+ * (drivers/clk/msm/clock-pll.c) is MODE 0x00, L 0x04, M 0x08, N 0x0C,
+ * USER_CTL 0x10, CONFIG_CTL 0x14, STATUS 0x1C; the lock bit is STATUS bit 16
+ * and the enable order is BYPASSNL, 10 us, RESET_N, poll, then OUTCTRL.
+ * VDD_APC is PM8937 S5, driven through the cluster-1 SPM at 0x0b011200
+ * (SAW_RST 0x18, PMIC_STS 0x14, VCTL 0x1C, AVS_CTL 0x20, PMIC_DATA_3 0x4C).
+ * The CPR block at 0x0b018000 trims the rail for the boot frequency, so it is
+ * stopped before the voltage is raised.  Boot args: vincemhz (MHz, default
+ * 1401), vincevolt (mV, default 1300), vincecpr (1 = stop CPR, default 1),
+ * vincedry (1 = dump the clock state and return).
+ */
+static void
+vince_clk_dump(const char *tag, vm_offset_t pll, vm_offset_t rcg)
+{
+	uint32_t cfg = *(volatile uint32_t *)(rcg + 0x54);
+
+	IOLog("VINCE CLK: %s pll mode %#x l %u m %u n %u user %#x cfg %#x sts %#x\n", tag,
+	    *(volatile uint32_t *)(pll + 0x00), *(volatile uint32_t *)(pll + 0x04),
+	    *(volatile uint32_t *)(pll + 0x08), *(volatile uint32_t *)(pll + 0x0C),
+	    *(volatile uint32_t *)(pll + 0x10), *(volatile uint32_t *)(pll + 0x14),
+	    *(volatile uint32_t *)(pll + 0x1C));
+	IOLog("VINCE CLK: %s rcg cmd %#x cfg %#x src %u div %u\n", tag,
+	    *(volatile uint32_t *)(rcg + 0x50), cfg, (cfg >> 8) & 7u, cfg & 0x1Fu);
+}
+
+static bool
+vince_rcg_switch(vm_offset_t rcg, uint32_t val)
+{
+	volatile uint32_t *cmd = (volatile uint32_t *)(rcg + 0x50);
+	volatile uint32_t *cfg = (volatile uint32_t *)(rcg + 0x54);
+	int i;
+
+	*cfg = val;
+	__builtin_arm_dsb(DSB_SY);
+	*cmd = *cmd | 1u;               /* CMD_RCGR_CONFIG_UPDATE_BIT */
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 500; i++) {
+		if (!(*cmd & 1u)) {
+			return true;
+		}
+		IODelay(1);
+	}
+	IOLog("VINCE CLK: rcg %#lx update stuck, cmd %#x cfg %#x\n", (unsigned long)rcg, *cmd, *cfg);
+	return false;
+}
+
+static bool
+vince_pll_set(vm_offset_t pll, uint32_t l_val)
+{
+	uint32_t mode, user, sts = 0;
+	int i;
+
+	/* The RCG must already be on another source: this clears the output. */
+	mode = *(volatile uint32_t *)(pll + 0x00) & ~0xFu;
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(10);
+
+	*(volatile uint32_t *)(pll + 0x04) = l_val;
+	*(volatile uint32_t *)(pll + 0x08) = 0;
+	*(volatile uint32_t *)(pll + 0x0C) = 0;
+	user = *(volatile uint32_t *)(pll + 0x10);
+	user &= ~((1u << 24) | (1u << 12) | (3u << 8) | (3u << 28));
+	user |= 1u;                     /* main output enable */
+	*(volatile uint32_t *)(pll + 0x10) = user;
+	__builtin_arm_dsb(DSB_SY);
+
+	mode |= 0x2;                    /* PLL_BYPASSNL */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(10);
+	mode |= 0x4;                    /* PLL_RESET_N */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 200; i++) {
+		sts = *(volatile uint32_t *)(pll + 0x1C);
+		if (sts & (1u << 16)) {
+			break;
+		}
+		IODelay(1);
+	}
+	if (!(sts & (1u << 16))) {
+		IOLog("VINCE CLK: pll %#lx did not lock, mode %#x user %#x sts %#x\n",
+		    (unsigned long)pll, mode, user, sts);
+		return false;
+	}
+	mode |= 0x1;                    /* PLL_OUTCTRL */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IOLog("VINCE CLK: pll %#lx locked, L=%u, mode %#x user %#x sts %#x\n",
+	    (unsigned long)pll, l_val, mode, user, sts);
+	return true;
+}
+
+static void
+vince_cpr_stop(vm_offset_t cpr)
+{
+	uint32_t ctl = *(volatile uint32_t *)(cpr + 0x90);
+
+	*(volatile uint32_t *)(cpr + 0x90) = ctl & ~((1u << 0) | (1u << 3) | (1u << 5) | (1u << 6));
+	__builtin_arm_dsb(DSB_SY);
+	IOLog("VINCE CLK: CPR ctl %#x -> %#x, result %#x/%#x\n", ctl,
+	    *(volatile uint32_t *)(cpr + 0x90), *(volatile uint32_t *)(cpr + 0xA0),
+	    *(volatile uint32_t *)(cpr + 0xA4));
+}
+
+static bool
+vince_apc_voltage(vm_offset_t spm, uint32_t mv)
+{
+	uint32_t avs, vlevel, vctl, data3, sts = 0;
+	bool ok = false;
+	int i;
+
+	/* PM8937 S5 is FTS2.5 range 0: VSET = (uV - 80 mV) / 5 mV. */
+	vlevel = (mv * 1000u - 80000u) / 5000u;
+	if (vlevel > 0xFEu) {
+		vlevel = 0xFEu;
+	}
+	avs = *(volatile uint32_t *)(spm + 0x20);
+	if (avs & 1u) {
+		*(volatile uint32_t *)(spm + 0x20) = avs & ~(1u << 27);
+		__builtin_arm_dsb(DSB_SY);
+	}
+	*(volatile uint32_t *)(spm + 0x18) = 1;         /* SAW_RST: FSM to idle */
+	__builtin_arm_dsb(DSB_SY);
+	vctl = *(volatile uint32_t *)(spm + 0x1C);
+	data3 = *(volatile uint32_t *)(spm + 0x4C);
+	vctl = (vctl & ~0x700FFu) | (vlevel & 0xFFu);
+	data3 = (data3 & ~0x700FFu) | (vlevel & 0xFFu);
+	*(volatile uint32_t *)(spm + 0x1C) = vctl;
+	__builtin_arm_dsb(DSB_SY);
+	*(volatile uint32_t *)(spm + 0x4C) = data3;
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 2000; i++) {
+		sts = *(volatile uint32_t *)(spm + 0x14);
+		if ((sts & 0x30000u) == 0 && (sts & 0xFFu) == (vlevel & 0xFFu)) {
+			ok = true;
+			break;
+		}
+		IODelay(1);
+	}
+	if (avs & 1u) {
+		*(volatile uint32_t *)(spm + 0x20) = avs;
+		__builtin_arm_dsb(DSB_SY);
+	}
+	IOLog("VINCE CLK: S5 %u mV (vlevel %#x), sts %#x after %d us, %s\n", mv, vlevel, sts, i,
+	    ok ? "set" : "not confirmed");
+	return ok;
+}
