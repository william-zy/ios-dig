+/*
+ * APCS clocks and VDD_APC for DIG-AL00 (PM8937).  CPU0 is cluster 1 (MPIDR
+ * 0x100): its RCG is at 0x0b011050 and its A53 PLL at 0x0b016000; cluster 0
+ * (CPUs 4-7) uses 0x0b111050 and 0x0b116000.  The vendor SR2 PLL layout
+ * (drivers/clk/msm/clock-pll.c) is MODE 0x00, L 0x04, M 0x08, N 0x0C,
+ * USER_CTL 0x10, CONFIG_CTL 0x14, STATUS 0x1C; the lock bit is STATUS bit 16
+ * and the enable order is BYPASSNL, 10 us, RESET_N, poll, then OUTCTRL.
+ * VDD_APC is PM8937 S5 behind the cluster-1 SPM at 0x0b011200 (SAW_RST 0x18,
+ * PMIC_STS 0x14, VCTL 0x1C, AVS_CTL 0x20, PMIC_DATA_3 0x4C); the CPR block at
+ * 0x0b018000 trims it for the boot frequency.
+ *
+ * The default is to leave the clocks alone.  Raising them needs all of
+ * vincemhz (>800), vincevolt (mV, >=1000) and vincecpr=1; vincedump=1 adds
+ * the CPR/SPM reads (those blocks may be unclocked early in boot).
+ */
+static void
+vince_clk_dump(const char *tag, vm_offset_t pll, vm_offset_t base)
+{
+	uint32_t cmd = *(volatile uint32_t *)(base + 0x50);
+	uint32_t cfg = *(volatile uint32_t *)(base + 0x54);
+
+	IOLog("VINCE CLK: %s pll mode %#x l %u m %u n %u user %#x cfg %#x sts %#x\n", tag,
+	    *(volatile uint32_t *)(pll + 0x00), *(volatile uint32_t *)(pll + 0x04),
+	    *(volatile uint32_t *)(pll + 0x08), *(volatile uint32_t *)(pll + 0x0C),
+	    *(volatile uint32_t *)(pll + 0x10), *(volatile uint32_t *)(pll + 0x14),
+	    *(volatile uint32_t *)(pll + 0x1C));
+	IOLog("VINCE CLK: %s rcg cmd %#x cfg %#x src %u div %u\n", tag,
+	    cmd, cfg, (cfg >> 8) & 7u, cfg & 0x1Fu);
+}
+
+static bool
+vince_rcg_switch_q(vm_offset_t base, uint32_t val)
+{
+	volatile uint32_t *cmd = (volatile uint32_t *)(base + 0x50);
+	volatile uint32_t *cfg = (volatile uint32_t *)(base + 0x54);
+	int i;
+
+	*cfg = val;
+	__builtin_arm_dsb(DSB_SY);
+	*cmd = *cmd | 1u;               /* CMD_RCGR_CONFIG_UPDATE_BIT */
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 500; i++) {
+		if (!(*cmd & 1u)) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+static bool
+vince_rcg_switch(vm_offset_t base, uint32_t val)
+{
+	if (vince_rcg_switch_q(base, val)) {
+		return true;
+	}
+	IOLog("VINCE CLK: rcg %#lx update stuck, cmd %#x cfg %#x\n", (unsigned long)base,
+	    *(volatile uint32_t *)(base + 0x50), *(volatile uint32_t *)(base + 0x54));
+	return false;
+}
+
+static bool
+vince_pll_set(vm_offset_t pll, uint32_t l_val)
+{
+	uint32_t mode, user, sts = 0;
+	int i;
+
+	/* The RCG must already be on another source: this clears the output. */
+	mode = *(volatile uint32_t *)(pll + 0x00) & ~0xFu;
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(10);
+
+	*(volatile uint32_t *)(pll + 0x04) = l_val;
+	*(volatile uint32_t *)(pll + 0x08) = 0;
+	*(volatile uint32_t *)(pll + 0x0C) = 0;
+	user = *(volatile uint32_t *)(pll + 0x10);
+	user &= ~((1u << 24) | (1u << 12) | (3u << 8) | (3u << 28));
+	user |= 1u;                     /* main output enable */
+	*(volatile uint32_t *)(pll + 0x10) = user;
+	__builtin_arm_dsb(DSB_SY);
+
+	mode |= 0x2;                    /* PLL_BYPASSNL */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(10);
+	mode |= 0x4;                    /* PLL_RESET_N */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 200; i++) {
+		sts = *(volatile uint32_t *)(pll + 0x1C);
+		if (sts & (1u << 16)) {
+			break;
+		}
+		IODelay(1);
+	}
+	if (!(sts & (1u << 16))) {
+		IOLog("VINCE CLK: pll %#lx did not lock, mode %#x user %#x sts %#x\n",
+		    (unsigned long)pll, mode, user, sts);
+		return false;
+	}
+	mode |= 0x1;                    /* PLL_OUTCTRL */
+	*(volatile uint32_t *)(pll + 0x00) = mode;
+	__builtin_arm_dsb(DSB_SY);
+	IOLog("VINCE CLK: pll %#lx locked, L=%u, mode %#x user %#x sts %#x\n",
+	    (unsigned long)pll, l_val, mode, user, sts);
+	return true;
+}
+
+/*
+ * Vendor early-init recipe for the C0 PLL (clock-cpu-8939.c,
+ * configure_enable_sr2_pll).  LK never configures the C0 PLL on this
+ * board, and vince_pll_set leaves USER_CTL/CONFIG_CTL at their reset
+ * values; Android writes USER_CTL 0x0100000f and CONFIG_CTL 0x4c015765
+ * once and only changes L afterwards (variable_rate_pll_set_rate).
+ */
+static bool
+vince_pll0_config(vm_offset_t pll, uint32_t l_val)
+{
+	uint32_t sts = 0;
+	int i;
+
+	*(volatile uint32_t *)(pll + 0x00) = 0;             /* MODE: off */
+	__builtin_arm_dsb(DSB_SY);
+	*(volatile uint32_t *)(pll + 0x04) = l_val;
+	*(volatile uint32_t *)(pll + 0x08) = 0;             /* M */
+	*(volatile uint32_t *)(pll + 0x0C) = 1;             /* N */
+	*(volatile uint32_t *)(pll + 0x10) = 0x0100000fu;   /* USER_CTL */
+	*(volatile uint32_t *)(pll + 0x14) = 0x4c015765u;   /* CONFIG_CTL */
+	__builtin_arm_dsb(DSB_SY);
+	*(volatile uint32_t *)(pll + 0x00) = 0x2;           /* PLL_BYPASSNL */
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(2);
+	*(volatile uint32_t *)(pll + 0x00) = 0x6;           /* PLL_RESET_N */
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 200; i++) {
+		sts = *(volatile uint32_t *)(pll + 0x1C);
+		if (sts & (1u << 16)) {
+			break;
+		}
+		IODelay(1);
+	}
+	if (!(sts & (1u << 16))) {
+		IOLog("VINCE CLK: c0 pll did not lock, mode %#x sts %#x\n",
+		    *(volatile uint32_t *)(pll + 0x00), sts);
+		return false;
+	}
+	*(volatile uint32_t *)(pll + 0x00) = 0x7;           /* PLL_OUTCTRL */
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(50);
+	IOLog("VINCE CLK: c0 pll locked, L=%u, user %#x cfg %#x sts %#x\n", l_val,
+	    *(volatile uint32_t *)(pll + 0x10), *(volatile uint32_t *)(pll + 0x14), sts);
+	return true;
+}
+
+static void
+vince_cpr_stop(vm_offset_t cpr)
+{
+	uint32_t ctl = *(volatile uint32_t *)(cpr + 0x90);
+
+	*(volatile uint32_t *)(cpr + 0x90) = ctl & ~((1u << 0) | (1u << 3) | (1u << 5) | (1u << 6));
+	__builtin_arm_dsb(DSB_SY);
+	IOLog("VINCE CLK: CPR ctl %#x -> %#x, result %#x/%#x\n", ctl,
+	    *(volatile uint32_t *)(cpr + 0x90), *(volatile uint32_t *)(cpr + 0xA0),
+	    *(volatile uint32_t *)(cpr + 0xA4));
+}
+
+static bool
+vince_apc_voltage(vm_offset_t spm, uint32_t mv)
+{
+	uint32_t avs, vlevel, vctl, data3, sts = 0;
+	bool ok = false;
+	int i;
+
+	/* PM8937 S5 is FTS2.5 range 0: VSET = (uV - 80 mV) / 5 mV. */
+	vlevel = (mv * 1000u - 80000u) / 5000u;
+	if (vlevel > 0xFEu) {
+		vlevel = 0xFEu;
+	}
+	avs = *(volatile uint32_t *)(spm + 0x20);
+	if (avs & 1u) {
+		*(volatile uint32_t *)(spm + 0x20) = avs & ~(1u << 27);
+		__builtin_arm_dsb(DSB_SY);
+	}
+	*(volatile uint32_t *)(spm + 0x18) = 1;         /* SAW_RST: FSM to idle */
+	__builtin_arm_dsb(DSB_SY);
+	vctl = *(volatile uint32_t *)(spm + 0x1C);
+	data3 = *(volatile uint32_t *)(spm + 0x4C);
+	vctl = (vctl & ~0x700FFu) | (vlevel & 0xFFu);
+	data3 = (data3 & ~0x700FFu) | (vlevel & 0xFFu);
+	*(volatile uint32_t *)(spm + 0x1C) = vctl;
+	__builtin_arm_dsb(DSB_SY);
+	*(volatile uint32_t *)(spm + 0x4C) = data3;
+	__builtin_arm_dsb(DSB_SY);
+	for (i = 0; i < 2000; i++) {
+		sts = *(volatile uint32_t *)(spm + 0x14);
+		if ((sts & 0x30000u) == 0 && (sts & 0xFFu) == (vlevel & 0xFFu)) {
+			ok = true;
+			break;
+		}
+		IODelay(1);
+	}
+	if (avs & 1u) {
+		*(volatile uint32_t *)(spm + 0x20) = avs;
+		__builtin_arm_dsb(DSB_SY);
+	}
+	IOLog("VINCE CLK: S5 %u mV (vlevel %#x), sts %#x after %d us, %s\n", mv, vlevel, sts, i,
+	    ok ? "set" : "not confirmed");
+	return ok;
+}
+static vm_offset_t vince_c0_base;
+static uint32_t vince_c0_ready;
+static uint32_t vince_c0_mhz;
+
+/*
+ * The kick runs with interrupts disabled (initCPU), where IOLog panics
+ * with "Console I/O from interrupt-disabled context".  Record the steps
+ * here and let finishStart print them from a normal thread.
+ */
+struct vince_c0_diag {
+	uint32_t ran, cpu, step, failed;
+	uint32_t cmd0, cfg0, cbcr0, cmd1, cfg1, cmd2, cfg2;
+};
+static struct vince_c0_diag vince_c0_diag;
+
+/*
+ * The C0 RCG update does not complete while cluster 0 is power-collapsed,
+ * so the boot CPU only configures the C0 PLL.  The first cluster-0 CPU to
+ * run initCPU walks the mux the way the vendor early-init code does: on to
+ * GPLL0/2 (a known-good 400 MHz) and then on to the A53 PLL.
+ */
+static void
+vince_c0_kick(unsigned cpu)
+{
+	volatile uint32_t *cmd, *cfg, *cbcr;
+	uint32_t cbcr_val;
+
+	if (!vince_c0_ready || !vince_c0_base) {
+		return;
+	}
+	if (!__sync_bool_compare_and_swap(&vince_c0_ready, 1u, 0u)) {
+		return;
+	}
+	cmd = (volatile uint32_t *)(vince_c0_base + 0x50);
+	cfg = (volatile uint32_t *)(vince_c0_base + 0x54);
+	cbcr = (volatile uint32_t *)(vince_c0_base + 0x58);  /* APCS_ALIAS0_CORE_CBCR */
+	cbcr_val = *cbcr;
+	vince_c0_diag.ran = 1;
+	vince_c0_diag.cpu = cpu;
+	vince_c0_diag.cmd0 = *cmd;
+	vince_c0_diag.cfg0 = *cfg;
+	vince_c0_diag.cbcr0 = cbcr_val;
+	if (*cmd & 1u) {
+		vince_c0_diag.step = 1;
+		vince_c0_diag.failed = 1;
+		return;
+	}
+	if (!(cbcr_val & 1u)) {
+		*cbcr = cbcr_val | 1u;
+		__builtin_arm_dsb(DSB_SY);
+	}
+	vince_c0_diag.step = 2;
+	if (!vince_rcg_switch_q(vince_c0_base, 0x403u)) {
+		vince_c0_diag.failed = 1;
+		return;
+	}
+	vince_c0_diag.cmd1 = *cmd;
+	vince_c0_diag.cfg1 = *cfg;
+	vince_c0_diag.step = 3;
+	for (int i = 0; i < 2000; i++) {
+		IODelay(1);
+	}
+	if (!vince_rcg_switch_q(vince_c0_base, 0x501u)) {
+		vince_c0_diag.failed = 1;
+		return;
+	}
+	vince_c0_diag.cmd2 = *cmd;
+	vince_c0_diag.cfg2 = *cfg;
+	vince_c0_diag.step = 4;
+}
