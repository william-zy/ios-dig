+/* The sanitizer's packet walk is our own guess at CP packet sizes and has
+ * replaced real load-state payload words (0xffffffff) that the CP accepts, so
+ * keep it off unless a boot-arg explicitly asks for it. */
+static int
+sanitize_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("sweetsanitize", &enabled, sizeof(enabled));
+		printf("adreno: IB sanitize %s by boot-arg\n",
+		    enabled ? "enabled" : "disabled");
+	}
+	return enabled;
+}
+
+/* Setting render mode 1 before the IBs made the CP fail earlier than the 0225
+ * sequence did, so keep that packet opt-in as well. */
+static int
+render_mode1_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("sweetmode1", &enabled, sizeof(enabled));
+		printf("adreno: leading render mode 1 %s by boot-arg\n",
+		    enabled ? "enabled" : "disabled");
+	}
+	return enabled;
+}
