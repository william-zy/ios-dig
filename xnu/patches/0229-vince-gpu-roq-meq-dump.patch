 static void dump_ib_window(uint64_t pa, uint32_t dwords, uint32_t at, const char *what);
 
+/* The CP queue debug ports are indexed: writing ADDR selects the entry and
+ * the first DATA read still returns the previously selected one. */
+static uint32_t
+cp_queue_read(uint32_t addr_reg, uint32_t data_reg, uint32_t index)
+{
+	gw(addr_reg, index);
+	(void)gr(data_reg);
+	return gr(data_reg);
+}
+
+/*
+ * On a CP opcode error the offending packet has already left the ring and the
+ * IB cursor (IB1_BUFSZ) can only bound where it happened.  The ROQ holds the
+ * packets the PFP decoded, so dump it verbatim.
+ */
+static void
+dump_cp_queues(void)
+{
+	printf("adreno: ROQ thr=%#x/%#x MEQ thr=%#x\n",
+	    gr(A5_CP_ROQ_THRESHOLDS_1), gr(A5_CP_ROQ_THRESHOLDS_2),
+	    gr(A5_CP_MEQ_THRESHOLDS));
+	printf("adreno: ROQ:");
+	for (uint32_t i = 0; i < 256; i++) {
+		printf(" %#x",
+		    cp_queue_read(A5_CP_ROQ_DBG_ADDR, A5_CP_ROQ_DBG_DATA, i));
+		if ((i & 15u) == 15u) {
+			printf("\n");
+			if (i != 255) {
+				printf("adreno: ROQ+%u:", i + 1);
+			}
+		}
+	}
+	printf("adreno: MEQ:");
+	for (uint32_t i = 0; i < 32; i++) {
+		printf(" %#x",
+		    cp_queue_read(A5_CP_MEQ_DBG_ADDR, A5_CP_MEQ_DBG_DATA, i));
+		if ((i & 15u) == 15u) {
+			printf("\n");
+			if (i != 31) {
+				printf("adreno: MEQ+%u:", i + 1);
+			}
+		}
+	}
+}
+
 void
 vince_gpu_status(void)
 {
