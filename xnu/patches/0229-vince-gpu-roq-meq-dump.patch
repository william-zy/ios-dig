-				dump_ib_window(ib1, ib_track_words[i], bufsz, "if-bufsz-is-fetched");
+		if (cpint & 0x1u) {
+			dump_cp_queues();
+		}
+		for (uint32_t h = 0; h < IB_HISTORY; h++) {
+			for (uint32_t i = 0; i < ib_history[h].count; i++) {
+				if (ib_history[h].pa[i] != ib1 ||
+				    bufsz > ib_history[h].words[i]) {
+					continue;
+				}
+				printf("adreno: history fence %u ib %u\n",
+				    ib_history[h].fence, i);
+				dump_ib_window(ib1, ib_history[h].words[i],
+				    ib_history[h].words[i] - bufsz, "if-bufsz-is-left");
+				dump_ib_window(ib1, ib_history[h].words[i], bufsz,
+				    "if-bufsz-is-fetched");
 			}
 		}
 	}
