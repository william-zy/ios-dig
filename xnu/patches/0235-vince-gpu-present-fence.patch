+/*
+ * Latest fence that used each imported IOSurface.  A swap record names the
+ * surface, but Mesa has only queued the draw commands; present must wait
+ * for them or the panel shows the cleared rows as black bands mid-scroll.
+ */
+#define SURF_FENCE_SLOTS 64
+static struct {
+	uint32_t id;
+	uint32_t fence;
+} surf_fence[SURF_FENCE_SLOTS];
+static uint32_t surf_fence_next;
+
+void
+vince_gpu_surface_submitted(uint32_t id, uint32_t fence)
+{
+	uint32_t slot = SURF_FENCE_SLOTS;
+
+	if (id == 0 || fence == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < SURF_FENCE_SLOTS; i++) {
+		if (surf_fence[i].id == id) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == SURF_FENCE_SLOTS) {
+		slot = surf_fence_next;
+		surf_fence_next = (surf_fence_next + 1) % SURF_FENCE_SLOTS;
+		surf_fence[slot].id = id;
+		surf_fence[slot].fence = 0;
+	}
+	if ((int32_t)(fence - surf_fence[slot].fence) > 0) {
+		surf_fence[slot].fence = fence;
+	}
+}
+
+bool
+vince_gpu_surface_wait(uint32_t id, uint32_t timeout_ms)
+{
+	uint32_t fence = 0;
+
+	for (uint32_t i = 0; i < SURF_FENCE_SLOTS; i++) {
+		if (surf_fence[i].id == id) {
+			fence = surf_fence[i].fence;
+			break;
+		}
+	}
+	if (fence == 0) {
+		return true;
+	}
+	for (uint32_t waited = 0; waited < timeout_ms; waited++) {
+		if (vince_gpu_done(fence)) {
+			return true;
+		}
+		delay(1000);
+	}
+	return vince_gpu_done(fence);
+}
