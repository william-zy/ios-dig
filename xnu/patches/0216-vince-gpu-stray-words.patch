+/*
+ * A word 0xffffffff at a packet boundary decodes as a type-3 packet with
+ * opcode 0xff and a 64K count.  Mesa only emits that value as padding
+ * inside a CP_LOAD_STATE4 payload, so on a boundary it is stale data in a
+ * reused buffer.  Replace it with a one-dword CP_NOP so the rest of the
+ * stream can run; log every replacement (diagnostic build).
+ */
+static uint32_t
+sanitize_ib(uint64_t pa, uint32_t dwords)
+{
+	uint32_t n = MIN(dwords, 4096u);
+	vm_size_t bytes = (vm_size_t)((pa & 0xfffu) + (uint64_t)n * 4u);
+	vm_offset_t va = ml_io_map((vm_offset_t)(pa & ~0xfffull), (bytes + 0xfffu) & ~(vm_size_t)0xfffu);
+	uint32_t off = (uint32_t)(pa & 0xfffu);
+	uint32_t j = 0, fixed = 0;
+
+	if (va == 0) {
+		return 0;
+	}
+	while (j < n) {
+		uint32_t h = reg_read(va, off + j * 4u);
+
+		if ((h & 0xc0000000u) == 0) {
+			j += ((h >> 16) & 0x3fffu) + 1u;        /* type 0 */
+		} else if ((h & 0xf0000000u) == 0x40000000u) {
+			j += (h & 0x7fu) + 1u;                  /* type 4 */
+		} else if ((h & 0xf0000000u) == 0x70000000u) {
+			j += ((h & 0x3fffu) + 1u);              /* type 7 */
+		} else if (h == 0xffffffffu) {
+			reg_write(va, off + j * 4u, 0x70108000u); /* pkt7(CP_NOP, 0) */
+			printf("adreno: sanitize stray 0xffffffff at %u/%u\n", j, n);
+			fixed++;
+			j++;
+		} else {
+			j++;
+		}
+	}
+	return fixed;
+}
+
