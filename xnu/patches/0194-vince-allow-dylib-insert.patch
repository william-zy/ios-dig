diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -268,6 +268,8 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
 	if (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
 		*cs_flags |= CS_PLATFORM_BINARY;
+		/* SWEET: allow DYLD_INSERT_LIBRARIES into rootfs daemons. */
+		*cs_flags &= ~(CS_RESTRICT | CS_REQUIRE_LV);
