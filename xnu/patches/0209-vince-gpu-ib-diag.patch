+/*
+ * Run a trivially valid IB through the same CP path a client IB takes.  If
+ * the scratch word and the timestamp arrive, CP_INDIRECT_BUFFER_PFE and the
+ * event write work, and a failing GPU submit is about its contents.
+ */
+static bool
+ib_selftest(void)
+{
+	const uint32_t ib_off = GPU_SCRATCH_OFF + 0x1000;
+	uint32_t ib[9];
+	uint32_t n = 0, mem, ts;
+
+	ib[n++] = pkt7(CP_MEM_WRITE, 3);
+	ib[n++] = GPU_MEM_PA + GPU_SCRATCH_OFF + 0x24;
+	ib[n++] = 0;
+	ib[n++] = 0xc0ffee03u;
+	ib[n++] = pkt7(CP_EVENT_WRITE, 4);
+	ib[n++] = 0x80000004u;
+	ib[n++] = GPU_MEM_PA + GPU_SCRATCH_OFF + 0x28;
+	ib[n++] = 0;
+	ib[n++] = 0x1234u;
+
+	gmem_w32(GPU_SCRATCH_OFF + 0x24, 0);
+	gmem_w32(GPU_SCRATCH_OFF + 0x28, 0);
+	for (uint32_t j = 0; j < n; j++) {
+		gmem_w32(ib_off + j * 4u, ib[j]);
+	}
+
+	gw(A5_RBBM_INT_CLEAR_CMD, gr(A5_RBBM_INT_0_STATUS));
+	rb_emit(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+	rb_emit(GPU_MEM_PA + ib_off);
+	rb_emit(0);
+	rb_emit(n);
+	if (!rb_flush("IB selftest")) {
+		printf("adreno: ib selftest: NOT consumed\n");
+		return false;
+	}
+	delay(10000);
+	mem = gmem_r32(GPU_SCRATCH_OFF + 0x24);
+	ts = gmem_r32(GPU_SCRATCH_OFF + 0x28);
+	printf("adreno: ib selftest: mem=%#x ts=%#x INT0=%#x CPINT=%#x RPTR=%u\n",
+		mem, ts, gr(A5_RBBM_INT_0_STATUS), gr(A5_CP_INTERRUPT_STATUS),
+		gr(A5_CP_RB_RPTR));
+	return mem == 0xc0ffee03u && ts == 0x1234u;
+}
