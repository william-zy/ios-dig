+/* Is [address, address + bytes) inside this buffer's GPU range? */
+bool
+VinceGPUUserClient::contains(const struct gpu_buffer *b, uint64_t address, uint64_t bytes)
+{
+	if (b == NULL || bytes == 0 || address < b->address) {
+		return false;
+	}
+	uint64_t offset = address - b->address;
+	return offset <= b->size && bytes <= b->size - offset;
+}
