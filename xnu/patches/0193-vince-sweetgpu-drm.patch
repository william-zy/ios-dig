+/*
+ * A zeroed BO the client can write through a cached mapping.  The SMMU is in
+ * bypass, so the GPU VA is the physical address and the pages must be
+ * contiguous; freedreno asks for small buffers and retries smaller ones.
+ */
+IOReturn
+VinceGPUUserClient::sweetGemNew(uint64_t size, uint64_t *out)
+{
+	uint64_t rounded = round_page_64(size);
+	IOBufferMemoryDescriptor *memory;
+	IOMemoryMap *umap;
+	uint64_t *pa;
+	uint64_t base = 0;
+	uint32_t npages, slot = GPU_BUFFERS;
+	struct gpu_buffer *b = NULL;
+
+	if (rounded == 0 || rounded > GPU_BUFFER_MAX || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	/*
+	 * The SMMU is in bypass, so a BO must be one contiguous physical range
+	 * for the single IOVA Mesa gets back.  A plain buffer descriptor scatters
+	 * its pages once the allocation is larger than a few of them (the first
+	 * 256 KB Mesa texture failed with kIOReturnNoMemory).
+	 */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous,
+	    (vm_size_t)rounded, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("VinceGPU: no contiguous BO for %llu bytes\n", (unsigned long long)rounded);
+		return kIOReturnNoMemory;
+	}
+	bzero(memory->getBytesNoCopy(), (size_t)rounded);
+	npages = (uint32_t)(rounded / PAGE_SIZE);
+	pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	if (pa == NULL) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t p = 0; p < npages; p++) {
+		IOByteCount segment = 0;
+		pa[p] = memory->getPhysicalSegment((IOByteCount)p * PAGE_SIZE, &segment, kIOMemoryMapperNone);
+		if (pa[p] == 0 || (pa[p] & PAGE_MASK) != 0 || segment < PAGE_SIZE ||
+		    (p != 0 && pa[p] != base + (uint64_t)p * PAGE_SIZE)) {
+			IOFreeData(pa, npages * sizeof(uint64_t));
+			memory->release();
+			return kIOReturnNoMemory;
+		}
+		base = pa[0];
+		flush_dcache64((addr64_t)pa[p], (unsigned)PAGE_SIZE, TRUE);
+	}
+	umap = memory->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (umap == NULL) {
+		IOFreeData(pa, npages * sizeof(uint64_t));
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	/* externalMethod holds gGPULock; IOLock is not recursive. */
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t h = (fNextBuffer + n) % GPU_BUFFERS;
+		if (fBuffers[h].memory == NULL) {
+			slot = h;
+			fNextBuffer = h + 1;
+			break;
+		}
+	}
+	if (slot != GPU_BUFFERS) {
+		b = &fBuffers[slot];
+		bzero(b, sizeof(*b));
+		b->memory = memory;
+		b->kernel = (uint8_t *)memory->getBytesNoCopy();
+		b->address = base;
+		b->size = rounded;
+		b->umap = umap;
+		b->pa = pa;
+		b->npages = npages;
+	}
+	if (slot == GPU_BUFFERS) {
+		umap->release();
+		IOFreeData(pa, npages * sizeof(uint64_t));
+		memory->release();
+		return kIOReturnNoResources;
+	}
+	if (!fLoggedNew) {
+		fLoggedNew = true;
+		IOLog("VinceGPU: new bo %u size %llu at %#llx, user %#llx\n", slot + 1,
+		    (unsigned long long)rounded, (unsigned long long)base,
+		    (unsigned long long)umap->getAddress());
+	}
+	out[0] = slot + 1;
+	out[1] = base;
+	out[2] = umap->getAddress();
+	return kIOReturnSuccess;
+}
+
+/* An IOSurface's pages as a BO; eagl passes the CPU mapping on the side. */
+IOReturn
+VinceGPUUserClient::sweetGemImport(uint32_t surfaceID, uint64_t *out)
+{
+	SweetSurface *surface = sweet_surface_copy(surfaceID);
+	IOMemoryDescriptor *md;
+	uint64_t size, base = 0, *pa;
+	uint32_t npages, slot = GPU_BUFFERS;
+	struct gpu_buffer *b = NULL;
+
+	if (surface == NULL || surface->memory == NULL) {
+		OSSafeReleaseNULL(surface);
+		return kIOReturnNotFound;
+	}
+	md = surface->memory;
+	size = md->getLength();
+	if (size == 0 || (size & PAGE_MASK) != 0 || size > GPU_BUFFER_MAX) {
+		surface->release();
+		return kIOReturnBadArgument;
+	}
+	if (md->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+		surface->release();
+		return kIOReturnVMError;
+	}
+	npages = (uint32_t)(size / PAGE_SIZE);
+	pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	if (pa == NULL) {
+		md->complete();
+		surface->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t p = 0; p < npages; p++) {
+		IOByteCount segment = 0;
+		pa[p] = md->getPhysicalSegment((IOByteCount)p * PAGE_SIZE, &segment, kIOMemoryMapperNone);
+		if (pa[p] == 0 || (pa[p] & PAGE_MASK) != 0 || segment < PAGE_SIZE ||
+		    (p != 0 && pa[p] != base + (uint64_t)p * PAGE_SIZE)) {
+			IOFreeData(pa, npages * sizeof(uint64_t));
+			md->complete();
+			surface->release();
+			return kIOReturnNoMemory;
+		}
+		base = pa[0];
+	}
+	md->retain();
+	/* externalMethod holds gGPULock; IOLock is not recursive. */
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t h = (fNextBuffer + n) % GPU_BUFFERS;
+		if (fBuffers[h].memory == NULL) {
+			slot = h;
+			fNextBuffer = h + 1;
+			break;
+		}
+	}
+	if (slot != GPU_BUFFERS) {
+		b = &fBuffers[slot];
+		bzero(b, sizeof(*b));
+		b->memory = md;
+		b->surface = surface;
+		b->address = base;
+		b->size = size;
+		b->pa = pa;
+		b->npages = npages;
+	}
+	if (slot == GPU_BUFFERS) {
+		md->release();
+		IOFreeData(pa, npages * sizeof(uint64_t));
+		md->complete();
+		surface->release();
+		return kIOReturnNoResources;
+	}
+	IOLog("VinceGPU: import surface %u size %llu at %#llx as bo %u\n", surfaceID,
+	    (unsigned long long)size, (unsigned long long)base, slot + 1);
+	out[0] = slot + 1;
+	out[1] = base;
+	out[2] = size;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VinceGPUUserClient::sweetSubmit(const void *input, size_t length, uint64_t *sequence)
+{
+	const struct sweet_submit_header *header = (const struct sweet_submit_header *)input;
+	const struct sweet_submit_ib *ibs;
+	const uint32_t *handles;
+	struct gpu_buffer **listed;
+	uint64_t addresses[GPU_SUBMIT_IBS];
+	uint32_t words[GPU_SUBMIT_IBS];
+	uint32_t nr_ibs, nr_bos, seq;
+	size_t need;
+
+	if (length < sizeof(*header)) {
+		return kIOReturnBadArgument;
+	}
+	nr_ibs = header->nr_ibs;
+	nr_bos = header->nr_bos;
+	if (nr_ibs == 0 || nr_ibs > GPU_SUBMIT_IBS || nr_bos == 0 || nr_bos > GPU_BUFFERS) {
+		return kIOReturnBadArgument;
+	}
+	need = sizeof(*header) + (size_t)nr_ibs * sizeof(struct sweet_submit_ib) +
+	    (size_t)nr_bos * sizeof(uint32_t);
+	if (length != need) {
+		return kIOReturnBadArgument;
+	}
+	ibs = (const struct sweet_submit_ib *)((const char *)input + sizeof(*header));
+	handles = (const uint32_t *)(ibs + nr_ibs);
+	listed = (struct gpu_buffer **)IOMallocData(nr_bos * sizeof(*listed));
+	if (listed == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOReturn ret = kIOReturnSuccess;
+	for (uint32_t i = 0; i < nr_bos; i++) {
+		listed[i] = buffer(handles[i]);
+		if (listed[i] == NULL) {
+			ret = kIOReturnBadArgument;
+			goto out;
+		}
+		/* CPU writes must be in memory before the GPU reads the buffers. */
+		flushBuffer(listed[i]);
+	}
+	for (uint32_t i = 0; i < nr_ibs; i++) {
+		uint64_t address = (uint64_t)ibs[i].address_lo | ((uint64_t)ibs[i].address_hi << 32);
+		uint32_t count = ibs[i].size_words;
+		bool owned = false;
+
+		if (count == 0 || (address & 3) || count > GPU_BUFFER_MAX / 4) {
+			ret = kIOReturnBadArgument;
+			goto out;
+		}
+		for (uint32_t j = 0; j < nr_bos && !owned; j++) {
+			owned = contains(listed[j], address, (uint64_t)count * 4);
+		}
+		if (!owned) {
+			ret = kIOReturnNotPermitted;
+			goto out;
+		}
+		addresses[i] = address;
+		words[i] = count;
+	}
+	seq = vince_gpu_submit(addresses, words, nr_ibs);
+	if (seq == 0) {
+		IOLog("VinceGPU: submit %u IBs failed\n", nr_ibs);
+		ret = kIOReturnNotReady;
+		goto out;
+	}
+	if (!fLoggedSubmit) {
+		fLoggedSubmit = true;
+		IOLog("VinceGPU: first submit %u IBs, %u BOs -> seq %u\n", nr_ibs, nr_bos, seq);
+	}
+	for (uint32_t i = 0; i < nr_bos; i++) {
+		listed[i]->lastFence = seq;
+		listed[i]->used = true;
+	}
+	*sequence = seq;
+
+out:
+	IOFreeData(listed, nr_bos * sizeof(*listed));
+	return ret;
+}
+
+/* After a fence: drop this CPU's cached lines so it sees the GPU's writes. */
+IOReturn
+VinceGPUUserClient::sweetCpuPrep(uint32_t handle)
+{
+	struct gpu_buffer *b = buffer(handle);
+
+	if (b == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (b->used && !vince_gpu_done(b->lastFence)) {
+		return kIOReturnBusy;
+	}
+	flushBuffer(b);
+	return kIOReturnSuccess;
 }
 
