diff --git a/bsd/dev/vince_smd.c b/bsd/dev/vince_smd.c
--- a/bsd/dev/vince_smd.c
+++ b/bsd/dev/vince_smd.c
@@ -100,6 +100,7 @@
 static vm_offset_t smem, apcs;
 static bool smd_started;
 static int smd_chan;
+static uint32_t smd_irq_bit = APCS_IPC_WCNSS;
 
 void
 vince_smd_sleep(unsigned ms)
@@ -158,6 +158,6 @@
 static void
 kick(void)
 {
 	__asm__ volatile("dsb osh" ::: "memory");
-	wr32(apcs + APCS_IPC, APCS_IPC_WCNSS);
+	wr32(apcs + APCS_IPC, smd_irq_bit);
 }
@@ -430,5 +430,400 @@
 	}
 	vince_wlan_start();
 	vince_bt_start();
 }
+/*
+ * RPM regulator requests (DIG-AL00). PM8937 LDOA5 (vcc_i2c 1.8 V) and LDOA10
+ * (touch VDD 2.8 V) belong to the RPM; LK leaves them off, so the FT5346 has
+ * no power and never answers on I2C.
+ *
+ * The RPM has no secured SMEM partition: the TOC in the last 4 KiB of SMEM lists
+ * only apps<->modem/Q6/WCNSS, so smem_get_entry() falls back to the legacy item
+ * table at 0xD0 for host 6 (vince_smd_item). Channel layout as in smd.c: the
+ * allocation table is item 13 (or 266), the info page item 14 + cid (138 + cid)
+ * and the FIFO item 338 + cid (202 + cid); the info page and FIFO live in the
+ * aux-mem1 region (0x60000). RPM channels are word-access channels
+ * (smd_private.c is_word_access_ch): the info page is 88 bytes and every
+ * control field is a u32, the FIFO bytes are unchanged.
+ * Doorbell APCS IPC bit 0, as msm8937.dtsi qcom,smd-rpm says (edge 15,
+ * irq-bitmask 1). Request layout, from drivers/soc/qcom/rpm-smd.c:
+ *   {u32 "req", u32 len} {u32 msg_id, u32 set, u32 rsc_type, u32 rsc_id,
+ *   u32 data_len} then KVPs {u32 key, u32 size, data}.
+ */
+#define RPM_EDGE_ID     15u
+#define RPM_IPC_BIT     (1u << 0)
+#define RPM_REQ_SERVICE 0x00716572u     /* "req" */
+#define RPM_RSC_LDOA    0x616f646cu     /* "ldoa" */
+#define RPM_KEY_SWEN    0x6e657773u     /* "swen" */
+#define RPM_KEY_UV      0x00007675u     /* "uv" */
+
+/* word-access half channel (struct smd_half_channel_word_access) */
+#define W_STATE         0x00u
+#define W_FDSR          0x04u
+#define W_FCTS          0x08u
+#define W_FCD           0x0Cu
+#define W_FHEAD         0x14u
+#define W_FTAIL         0x18u
+#define W_FSTATE        0x1Cu
+#define W_FBLOCK        0x20u
+#define W_TAIL          0x24u
+#define W_HEAD          0x28u
+#define W_HALF          44u
+
+static struct vsmd_ch rpm_ch;
+static bool rpm_opened;
+static bool rpm_word;
+static uint32_t rpm_msg_id;
+
+/* control field of our half: byte-access offsets or word-access offsets */
+static uint32_t
+rpm_rd(struct vsmd_ch *c, uint32_t boff, uint32_t woff)
+{
+	return rpm_word ? rd32(c->info + woff) : rd8(c->info + boff);
+}
+
+static void
+rpm_wr(struct vsmd_ch *c, uint32_t boff, uint32_t woff, uint32_t v)
+{
+	if (rpm_word) {
+		wr32(c->info + woff, v);
+	} else {
+		wr8(c->info + boff, (uint8_t)v);
+	}
+}
+
+static void
+rpm_set_state(struct vsmd_ch *c, uint32_t st)
+{
+	uint32_t open = st == ST_OPENED;
+
+	rpm_wr(c, I_FDSR, W_FDSR, open);
+	rpm_wr(c, I_FCTS, W_FCTS, open);
+	rpm_wr(c, I_FCD, W_FCD, open);
+	rpm_wr(c, I_STATE, W_STATE, st);
+	rpm_wr(c, I_FSTATE, W_FSTATE, 1);
+	kick();
+}
+
+static bool
+rpm_wait_remote(struct vsmd_ch *c, uint32_t a, uint32_t b, unsigned ms)
+{
+	for (unsigned t = 0; t <= ms; t += 5) {
+		uint32_t r = rpm_rd(c, I_HALF + I_STATE, W_HALF + W_STATE);
+
+		if (r == a || r == b) {
+			return true;
+		}
+		vince_smd_sleep(5);
+	}
+	return false;
+}
+
+static int
+rpm_open(struct vsmd_ch *c)
+{
+	printf("VINCE RPM: open info %#lx\n", (unsigned long)c->info);
+	/* the RPM half starts closed: announce OPENING and let it answer */
+	rpm_set_state(c, ST_OPENING);
+	if (!rpm_wait_remote(c, ST_OPENING, ST_OPENED, 2000)) {
+		rpm_set_state(c, ST_CLOSED);
+		return -2;
+	}
+	rpm_set_state(c, ST_OPENED);
+	if (!rpm_wait_remote(c, ST_OPENED, ST_OPENED, 2000)) {
+		rpm_set_state(c, ST_CLOSED);
+		return -3;
+	}
+	rpm_wr(c, I_HALF + I_FSTATE, W_HALF + W_FSTATE, 0);
+	rpm_wr(c, I_HEAD, W_HEAD, rpm_rd(c, I_TAIL, W_TAIL));
+	rpm_wr(c, I_HALF + I_TAIL, W_HALF + W_TAIL, rpm_rd(c, I_HALF + I_HEAD, W_HALF + W_HEAD));
+	__asm__ volatile("dsb osh" ::: "memory");
+	c->open = true;
+	return 0;
+}
+
+static int
+rpm_send(struct vsmd_ch *c, const void *data, uint32_t len)
+{
+	const uint8_t *p = data;
+	uint32_t head = rpm_rd(c, I_HEAD, W_HEAD), tail = rpm_rd(c, I_TAIL, W_TAIL);
+
+	if (!c->open || !len || len > MAX_PKT || head >= c->half || tail >= c->half) {
+		return -1;
+	}
+	if ((c->half - 1) - ((head - tail) & (c->half - 1)) < SMD_HDR + len) {
+		return -2;
+	}
+	uint8_t hdr[SMD_HDR] = { (uint8_t)len, (uint8_t)(len >> 8), (uint8_t)(len >> 16), (uint8_t)(len >> 24) };
+
+	rpm_wr(c, I_FTAIL, W_FTAIL, 0);
+	for (uint32_t i = 0; i < SMD_HDR; i++) {
+		wr8(c->fifo + head, hdr[i]);
+		head = (head + 1) & (c->half - 1);
+	}
+	for (uint32_t i = 0; i < len; i++) {
+		wr8(c->fifo + head, p[i]);
+		head = (head + 1) & (c->half - 1);
+	}
+	__asm__ volatile("dsb osh" ::: "memory");
+	rpm_wr(c, I_HEAD, W_HEAD, head);
+	rpm_wr(c, I_FHEAD, W_FHEAD, 1);
+	kick();
+	return 0;
+}
+
+static int
+rpm_recv(struct vsmd_ch *c, void *buf, uint32_t max, unsigned ms)
+{
+	uint8_t *out = buf;
+	vm_offset_t rx = c->fifo + c->half;
+
+	for (unsigned t = 0;; t += 5) {
+		uint32_t avail = (rpm_rd(c, I_HALF + I_HEAD, W_HALF + W_HEAD) -
+		    rpm_rd(c, I_HALF + I_TAIL, W_HALF + W_TAIL)) & (c->half - 1);
+
+		if (avail >= SMD_HDR) {
+			uint32_t tail = rpm_rd(c, I_HALF + I_TAIL, W_HALF + W_TAIL), len = 0;
+
+			for (uint32_t i = 0; i < 4; i++) {
+				len |= (uint32_t)rd8(rx + ((tail + i) & (c->half - 1))) << (8 * i);
+			}
+			if (!len || len > MAX_PKT || SMD_HDR + len > c->half - 1) {
+				return -1;
+			}
+			if (avail >= SMD_HDR + len) {
+				tail = (tail + SMD_HDR) & (c->half - 1);
+				for (uint32_t i = 0; i < len; i++) {
+					uint8_t b = rd8(rx + tail);
+
+					tail = (tail + 1) & (c->half - 1);
+					if (i < max) {
+						out[i] = b;
+					}
+				}
+				__asm__ volatile("dsb osh" ::: "memory");
+				rpm_wr(c, I_HALF + I_TAIL, W_HALF + W_TAIL, tail);
+				rpm_wr(c, I_HALF + I_FHEAD, W_HALF + W_FHEAD, 0);
+				rpm_wr(c, I_HALF + I_FTAIL, W_HALF + W_FTAIL, 1);
+				if (!rpm_rd(c, I_HALF + I_FBLOCK, W_HALF + W_FBLOCK)) {
+					kick();
+				}
+				return (int)len;
+			}
+		}
+		if (t >= ms) {
+			return 0;
+		}
+		vince_smd_sleep(5);
+	}
+}
+
+static void
+rpm_dump_item(const char *what, uint32_t item)
+{
+	uint32_t tb = 0xD0u + item * 16;
+
+	printf("VINCE RPM: %s item %u: alloc %#x off %#x size %#x aux %#x\n", what, item,
+	    srd32(tb), srd32(tb + 4), srd32(tb + 8), srd32(tb + 12) & ~3u);
+}
+
+static void
+rpm_show_table(int t)
+{
+	uint32_t tsz = 0;
+	vm_offset_t tbl = vince_smd_item(vtbls[t].alloc, &tsz);
+
+	if (!tbl) {
+		printf("VINCE RPM: no allocation table %d\n", t);
+		return;
+	}
+	for (uint32_t i = 0; i < 8 && (i + 1) * 32 <= tsz; i++) {
+		vm_offset_t e = tbl + i * 32;
+		char nm[21];
+
+		for (int j = 0; j < 20; j += 4) {
+			uint32_t w = rd32(e + j);
+
+			for (int b = 0; b < 4; b++) {
+				char ch = (char)(w >> (8 * b));
+
+				nm[j + b] = (ch >= 0x20 && ch < 0x7f) ? ch : 0;
+			}
+		}
+		nm[20] = 0;
+		printf("VINCE RPM: t%d[%u] %s cid %u type %#x ref %u\n", t, i, nm,
+		    rd32(e + 20), rd32(e + 24), rd32(e + 28));
+	}
+}
+
+/* find "rpm_requests" in the legacy SMD allocation tables */
+static bool
+rpm_find(struct vsmd_ch *c)
+{
+	for (int t = 0; t < 2; t++) {
+		uint32_t tsz = 0;
+		vm_offset_t tbl = vince_smd_item(vtbls[t].alloc, &tsz);
+
+		if (!tbl) {
+			continue;
+		}
+		for (uint32_t i = 0; i < 64 && (i + 1) * 32 <= tsz; i++) {
+			vm_offset_t e = tbl + i * 32;
+			char nm[21];
+
+			for (int j = 0; j < 20; j += 4) {
+				uint32_t w = rd32(e + j);
+
+				for (int b = 0; b < 4; b++) {
+					char ch = (char)(w >> (8 * b));
+
+					nm[j + b] = (ch >= 0x20 && ch < 0x7f) ? ch : 0;
+				}
+			}
+			nm[20] = 0;
+			uint32_t cid = rd32(e + 20), flags = rd32(e + 24), ref = rd32(e + 28);
+			if (!nm[0] || !ref || (flags & 0xff) != RPM_EDGE_ID || strncmp(nm, "rpm_requests", 20) != 0) {
+				continue;
+			}
+			uint32_t isz = 0, fsz = 0;
+			vm_offset_t io = vince_smd_item(vtbls[t].info + cid, &isz);
+			vm_offset_t fo = vince_smd_item(vtbls[t].fifo + cid, &fsz);
+			if (!io || !fo || (isz != 40 && isz != 88) || fsz < 0x100 || (fsz & (fsz - 1))) {
+				printf("VINCE RPM: %s cid %u: bad items (%#lx/%u %#lx/%u)\n", nm, cid,
+				    (unsigned long)io, isz, (unsigned long)fo, fsz);
+				rpm_dump_item("info", vtbls[t].info + cid);
+				rpm_dump_item("fifo", vtbls[t].fifo + cid);
+				return false;
+			}
+			rpm_word = isz == 88;
+			c->info = io;
+			c->fifo = fo;
+			c->half = fsz / 2;
+			printf("VINCE RPM: rpm_requests t%d cid %u, %s info, fifo %u bytes\n", t, cid,
+			    rpm_word ? "word" : "byte", fsz);
+			return true;
+		}
+	}
+	rpm_show_table(0);
+	rpm_show_table(1);
+	return false;
+}
+
+static bool
+rpm_init(void)
+{
+	if (rpm_opened) {
+		return true;
+	}
+	if (!vince_smd_map()) {
+		printf("VINCE RPM: SMEM mapping failed\n");
+		return false;
+	}
+	smd_irq_bit = RPM_IPC_BIT;
+	if (!rpm_find(&rpm_ch)) {
+		printf("VINCE RPM: no rpm_requests channel\n");
+		return false;
+	}
+	/* if both halves are already open (the bootloader used the channel), do not
+	 * repeat the handshake: the SError shows up about a second after it */
+	uint32_t ls = rpm_rd(&rpm_ch, I_STATE, W_STATE);
+	uint32_t rs = rpm_rd(&rpm_ch, I_HALF + I_STATE, W_HALF + W_STATE);
+
+	printf("VINCE RPM: state local %u remote %u\n", ls, rs);
+	vince_smd_sleep(1000);
+	if (ls == ST_OPENED && rs == ST_OPENED) {
+		rpm_ch.open = true;
+		printf("VINCE RPM: already open\n");
+		vince_smd_sleep(1000);
+	} else {
+		int r = rpm_open(&rpm_ch);
+
+		if (r) {
+			printf("VINCE RPM: rpm_requests open failed %d (tx %u rx %u)\n", r,
+			    rpm_rd(&rpm_ch, I_STATE, W_STATE),
+			    rpm_rd(&rpm_ch, I_HALF + I_STATE, W_HALF + W_STATE));
+			return false;
+		}
+	}
+	rpm_opened = true;
+	return true;
+}
+
+static void
+rpm_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+/* Enable an LDOA regulator at uv in both the active and the sleep set. */
+bool
+vince_rpm_ldo(unsigned id, uint32_t uv)
+{
+	uint8_t buf[64];
+	bool ok = true;
+
+	/* first: the heap entries only (main SMEM, always readable), then a pause so the
+	 * persistent log has them on disk before anything touches the aux region */
+	if (!vince_smd_map()) {
+		printf("VINCE RPM: SMEM mapping failed\n");
+		return false;
+	}
+	rpm_dump_item("alloc", vtbls[0].alloc);
+	rpm_dump_item("info", vtbls[0].info + 4);
+	rpm_dump_item("fifo", vtbls[0].fifo + 4);
+	rpm_dump_item("alloc2", vtbls[1].alloc);
+	rpm_dump_item("info2", vtbls[1].info + 4);
+	rpm_dump_item("fifo2", vtbls[1].fifo + 4);
+	vince_smd_sleep(2000);
+	smd_irq_bit = RPM_IPC_BIT;
+	printf("VINCE RPM: apcs test\n");
+	vince_smd_sleep(2000);
+	kick();
+	vince_smd_sleep(2000);
+	printf("VINCE RPM: apcs ok\n");
+	vince_smd_sleep(1000);
+	printf("VINCE RPM: init start\n");
+	vince_smd_sleep(2000);
+	if (!rpm_init()) {
+		printf("VINCE RPM: ldo%u stays off\n", id);
+		return false;
+	}
+	printf("VINCE RPM: init ok\n");
+	vince_smd_sleep(2000);
+	for (uint32_t set = 0; set < 2; set++) {
+		uint32_t msg_id = ++rpm_msg_id;
+		int r, n;
+
+		memset(buf, 0, sizeof(buf));
+		rpm_put32(buf + 0, RPM_REQ_SERVICE);
+		rpm_put32(buf + 4, 41);         /* message header (20) + kvps (21) */
+		rpm_put32(buf + 8, msg_id);
+		rpm_put32(buf + 12, set);
+		rpm_put32(buf + 16, RPM_RSC_LDOA);
+		rpm_put32(buf + 20, id);
+		rpm_put32(buf + 24, 21);
+		rpm_put32(buf + 28, RPM_KEY_SWEN);
+		rpm_put32(buf + 32, 1);
+		buf[36] = 1;
+		rpm_put32(buf + 37, RPM_KEY_UV);
+		rpm_put32(buf + 41, 4);
+		rpm_put32(buf + 45, uv);
+		printf("VINCE RPM: send set %u\n", set);
+		vince_smd_sleep(1000);
+		r = rpm_send(&rpm_ch, buf, 49);
+		printf("VINCE RPM: send set %u -> %d\n", set, r);
+		vince_smd_sleep(1000);
+		if (r) {
+			ok = false;
+			break;
+		}
+		n = rpm_recv(&rpm_ch, buf, sizeof(buf), 100);
+		printf("VINCE RPM: recv set %u -> %d\n", set, n);
+		vince_smd_sleep(500);
+	}
+	printf("VINCE RPM: ldo%u %u uV %s\n", id, uv, ok ? "requested" : "send failed");
+	return ok;
+}
 #endif /* ARM64_BOARD_CONFIG_VINCE */
